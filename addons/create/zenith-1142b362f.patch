diff --git a/mixins/create/engine/src/core/mechanical_crafting.rs b/mixins/create/engine/src/core/mechanical_crafting.rs
new file mode 100644
index 0000000..871f267
--- /dev/null
+++ b/mixins/create/engine/src/core/mechanical_crafting.rs
@@ -0,0 +1,129 @@
+// Copyright (c) 2026 create-horizon contributors
+// SPDX-License-Identifier: MIT
+
+//! Shaped Mechanical Crafter matching after a chain has collected its ingredients.
+//! World traversal, crafting priority and output transfer belong to the adapter.
+
+/// A row-major recipe pattern or assembled crafter grid. Empty outer rows and
+/// columns are ignored. Internal empty cells must stay empty.
+pub struct Grid<'a, T> {
+    cells: &'a [Option<T>],
+    stride: usize,
+    bounds: [usize; 4],
+}
+
+impl<'a, T> Grid<'a, T> {
+    /// Rows start at the top of the crafter as seen from the front.
+    pub fn new(width: usize, height: usize, cells: &'a [Option<T>]) -> Option<Self> {
+        if width == 0 || height == 0 || width.checked_mul(height)? != cells.len() {
+            return None;
+        }
+        let mut occupied = cells.iter().enumerate().filter(|(_, cell)| cell.is_some());
+        let (first, _) = occupied.next()?;
+        let (x, y) = (first % width, first / width);
+        let (mut left, mut right, mut bottom) = (x, x, y);
+        for (i, _) in occupied {
+            let x = i % width;
+            left = left.min(x);
+            right = right.max(x);
+            bottom = i / width;
+        }
+        Some(Self {
+            cells,
+            stride: width,
+            bounds: [left, y, right, bottom],
+        })
+    }
+
+    fn size(&self) -> (usize, usize) {
+        let [left, top, right, bottom] = self.bounds;
+        (right - left + 1, bottom - top + 1)
+    }
+
+    fn get(&self, x: usize, y: usize) -> Option<&T> {
+        let [left, top, ..] = self.bounds;
+        self.cells[(top + y) * self.stride + left + x].as_ref()
+    }
+}
+
+/// Matches a mechanical recipe. The caller supplies ingredient matching so
+/// stack components and item tags follow the game's own recipe semantics.
+pub fn matches<I, S>(
+    recipe: &Grid<'_, I>,
+    input: &Grid<'_, S>,
+    accept_mirrored: bool,
+    mut ingredient_matches: impl FnMut(&I, &S) -> bool,
+) -> bool {
+    let (width, height) = recipe.size();
+    if input.size() != (width, height) {
+        return false;
+    }
+
+    let mut matches = |mirror| {
+        (0..height).all(|y| {
+            (0..width).all(|x| {
+                let pattern_x = if mirror { width - x - 1 } else { x };
+                match (recipe.get(pattern_x, y), input.get(x, y)) {
+                    (Some(ingredient), Some(stack)) => ingredient_matches(ingredient, stack),
+                    (None, None) => true,
+                    _ => false,
+                }
+            })
+        })
+    };
+
+    matches(false) || (accept_mirrored && matches(true))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_grid_trims_borders_but_retains_holes() {
+        let recipe = Grid::new(2, 2, &[Some('a'), None, Some('b'), Some('a')]).unwrap();
+        let input = [
+            None,
+            None,
+            None,
+            None,
+            None,
+            Some('a'),
+            None,
+            None,
+            None,
+            Some('b'),
+            Some('a'),
+            None,
+        ];
+        let mut obstructed = input;
+        obstructed[6] = Some('a');
+        assert!(matches(
+            &recipe,
+            &Grid::new(4, 3, &input).unwrap(),
+            false,
+            char::eq
+        ));
+        assert!(!matches(
+            &recipe,
+            &Grid::new(4, 3, &obstructed).unwrap(),
+            false,
+            char::eq
+        ));
+    }
+
+    #[test]
+    fn an_asymmetric_recipe_mirrors_only_when_allowed() {
+        let recipe = Grid::new(3, 1, &[Some(1), Some(2), None]).unwrap();
+        let input = Grid::new(2, 1, &[Some(2), Some(1)]).unwrap();
+        assert!(!matches(&recipe, &input, false, i32::eq));
+        assert!(matches(&recipe, &input, true, i32::eq));
+    }
+
+    #[test]
+    fn an_empty_or_invalid_input_cannot_produce_a_recipe() {
+        assert!(Grid::<()>::new(1, 1, &[None]).is_none());
+        assert!(Grid::new(1, 2, &[Some(())]).is_none());
+        assert!(Grid::new(usize::MAX, 2, &[Some(())]).is_none());
+    }
+}
